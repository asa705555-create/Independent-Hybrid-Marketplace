# A dedicated project — never reuse secrets or databases from other projects.
NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
DEMO_EPHEMERAL=1
DEMO_SEED=1
OWNER_EMAIL=owner@example.invalid
# Set a NEW random 20+ character value in a private server environment.
OWNER_PASSWORD=
# Local-only; demo SQLite storage must never be mistaken for production persistence.
DB_FILE=./data/jame3-demo.sqlite

# Optional 32+ Base32-character secret: when set, owner sign-in REQUIRES TOTP.
# Generate privately; configure an authenticator app yourself. Never commit the secret.
OWNER_TOTP_SECRET=

# v0.6 — Dedicated PostgreSQL (prefer paid with backups for real persistence).
# Never use another project’s database. Leave unset for ephemeral demo.
# DATABASE_URL=postgresql://USER:PASSWORD@DEDICATED_HOST:5432/DEDICATED_JAME3_DB
# Enable only in a staging preview. Requires explicitly permitted separate DB.
# DEMO_EPHEMERAL=0
# For NODE_ENV=production + DATABASE_URL, OWNER_TOTP_SECRET is REQUIRED.
